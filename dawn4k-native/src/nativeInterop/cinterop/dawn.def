headers = dawn/webgpu.h dawn4k_runtime.h
headerFilter = dawn/webgpu.h dawn4k_runtime.h
package = webgpu.native
staticLibraries.macos_arm64 = libwebgpu_dawn.a
staticLibraries.ios_arm64 = libwebgpu_dawn.a
staticLibraries.ios_simulator_arm64 = libwebgpu_dawn.a
staticLibraries.ios_x64 = libwebgpu_dawn.a
staticLibraries.tvos_arm64 = libwebgpu_dawn.a
staticLibraries.tvos_simulator_arm64 = libwebgpu_dawn.a
staticLibraries.linux_x64 = libdawn4k_dawn.a
linkerOpts.macos_arm64 = -framework Metal -framework Foundation -framework CoreGraphics -framework QuartzCore -framework IOKit -framework IOSurface -lc++
linkerOpts.ios_arm64 = -framework Metal -framework Foundation -framework CoreGraphics -framework QuartzCore -framework IOKit -framework IOSurface -lc++
linkerOpts.ios_simulator_arm64 = -framework Metal -framework Foundation -framework CoreGraphics -framework QuartzCore -framework IOKit -framework IOSurface -lc++
linkerOpts.ios_x64 = -framework Metal -framework Foundation -framework CoreGraphics -framework QuartzCore -framework IOKit -framework IOSurface -lc++
linkerOpts.tvos_arm64 = -framework Metal -framework Foundation -framework CoreGraphics -framework QuartzCore -framework IOKit -framework IOSurface -lc++
linkerOpts.tvos_simulator_arm64 = -framework Metal -framework Foundation -framework CoreGraphics -framework QuartzCore -framework IOKit -framework IOSurface -lc++
linkerOpts.linux_x64 = -ldl -lpthread -lm
